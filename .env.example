# ── Base de données ──────────────────────────────────────────────────────────
# Local :
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sparepart
# Neon (Vercel) — récupérer dans Vercel > Storage > Neon > Connect :
# DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# Tests d'intégration (npm run test:integration) : base DÉDIÉE, vidée par les
# tests — son nom doit contenir « test ».
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sparepart_test

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production :
# NEXT_PUBLIC_SITE_URL=https://ton-domaine.vercel.app

# ── Admin (/admin/stats, /admin/review) ──────────────────────────────────────
# Authentification HTTP Basic. Sans ADMIN_PASSWORD, l'admin n'est accessible
# qu'en développement local (404 en production).
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Pipeline d'ingestion Ollama ───────────────────────────────────────────────
# Clé secrète protégeant /api/ingest, /api/lifecycle/* et /api/repair/*.
# Génère avec : openssl rand -hex 32
INGEST_API_KEY=remplace_par_une_cle_secrete
# URL de base ciblée par les scripts (push, lifecycle, accumulate).
# Défaut d'accumulate.ts : https://spare-part-bdd.vercel.app
# INGEST_URL=http://localhost:3000

# ── Enrichissement (scripts/ingest/accumulate.ts, optionnel) ─────────────────
# Gemini remplace Ollama quand la clé est définie.
GEMINI_API_KEY=

# ── APIs distributeurs (optionnel — données officielles, confidence 95%) ───────
# Mouser  : https://www.mouser.com/api-hub/  (inscription gratuite)
# Farnell : https://api.element14.com         (inscription email gratuite)
# RS      : https://api.rs-online.com         (inscription gratuite)
MOUSER_API_KEY=
FARNELL_API_KEY=
RS_API_KEY=
